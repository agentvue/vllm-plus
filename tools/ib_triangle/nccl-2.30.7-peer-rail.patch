+static ncclResult_t getNetNodeId(int* nodeId) {
+  const char* value = ncclGetEnv("NCCL_NET_NODE_ID");
+  *nodeId = -1;
+  if (value == NULL || value[0] == '\0') return ncclSuccess;
+
+  errno = 0;
+  char* end = NULL;
+  long parsed = strtol(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || parsed < 0 || parsed > INT_MAX) {
+    WARN("Invalid NCCL_NET_NODE_ID='%s'; expected an integer between 0 and %d", value, INT_MAX);
+    return ncclInvalidUsage;
+  }
+  *nodeId = (int)parsed;
+  INFO(NCCL_ENV, "NCCL_NET_NODE_ID set to %d", *nodeId);
+  return ncclSuccess;
+}
