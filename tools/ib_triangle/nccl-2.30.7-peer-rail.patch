+#define NCCL_MAX_PEER_RAIL_MAPPINGS 64
+
+struct ncclPeerRailMapping {
+  int nodeId;
+  int railId;
+};
+
+static struct {
+  bool enabled;
+  int count;
+  struct ncclPeerRailMapping entries[NCCL_MAX_PEER_RAIL_MAPPINGS];
+} peerRailMap;
+static ncclResult_t peerRailMapResult = ncclSuccess;
+static std::once_flag peerRailMapOnce;
+
+static void parsePeerRailMap() {
+  const char* value = ncclGetEnv("NCCL_NET_PEER_RAIL_MAP");
+  if (value == NULL || value[0] == '\0') return;
+  peerRailMap.enabled = true;
+
+  const char* cursor = value;
+  while (*cursor != '\0') {
+    errno = 0;
+    char* nodeEnd = NULL;
+    long nodeId = strtol(cursor, &nodeEnd, 10);
+    if (errno != 0 || nodeEnd == cursor || *nodeEnd != ':' || nodeId < 0 || nodeId > INT_MAX) goto invalid;
+
+    errno = 0;
+    char* railEnd = NULL;
+    long railId = strtol(nodeEnd + 1, &railEnd, 10);
+    if (errno != 0 || railEnd == nodeEnd + 1 || (*railEnd != ',' && *railEnd != '\0') || railId < 0 ||
+        railId > INT16_MAX) {
+      goto invalid;
+    }
+    if (peerRailMap.count == NCCL_MAX_PEER_RAIL_MAPPINGS) goto invalid;
+    for (int i = 0; i < peerRailMap.count; i++) {
+      if (peerRailMap.entries[i].nodeId == nodeId) goto invalid;
+    }
+
+    peerRailMap.entries[peerRailMap.count].nodeId = (int)nodeId;
+    peerRailMap.entries[peerRailMap.count].railId = (int)railId;
+    peerRailMap.count++;
+    if (*railEnd == '\0') break;
+    cursor = railEnd + 1;
+    if (*cursor == '\0') goto invalid;
+  }
+
+  INFO(NCCL_ENV | NCCL_NET, "NCCL_NET_PEER_RAIL_MAP set to %s", value);
+  return;
+
+invalid:
+  WARN("Invalid NCCL_NET_PEER_RAIL_MAP='%s'; expected unique peer_node:local_rail pairs separated by commas",
+       value);
+  peerRailMapResult = ncclInvalidUsage;
+  peerRailMap.count = 0;
+}
+
+static ncclResult_t getPeerRail(int peerNodeId, bool* enabled, int* railId) {
+  std::call_once(peerRailMapOnce, parsePeerRailMap);
+  NCCLCHECK(peerRailMapResult);
+  *enabled = peerRailMap.enabled;
+  if (!peerRailMap.enabled) return ncclSuccess;
+
+  for (int i = 0; i < peerRailMap.count; i++) {
+    if (peerRailMap.entries[i].nodeId == peerNodeId) {
+      *railId = peerRailMap.entries[i].railId;
+      return ncclSuccess;
+    }
+  }
+  WARN("NCCL_NET_PEER_RAIL_MAP has no rail for peer node ID %d", peerNodeId);
+  return ncclInvalidUsage;
+}
+
+static ncclResult_t applyPeerRail(struct ncclComm* comm, struct ncclPeerInfo* myInfo,
+                                  struct ncclPeerInfo* peerInfo, bool allowProxy, int64_t* netId, int* netDev,
+                                  int* proxyRank) {
+  if (myInfo->hostHash == peerInfo->hostHash) return ncclSuccess;
+
+  bool enabled;
+  int railId = -1;
+  NCCLCHECK(getPeerRail(peerInfo->netNodeId, &enabled, &railId));
+  if (!enabled) return ncclSuccess;
+
+  int deviceCount = 0;
+  NCCLCHECK(comm->ncclNet->devices(&deviceCount));
+  int selectedDev = -1;
+  int selectedSpeed = -1;
+  for (int dev = 0; dev < deviceCount; dev++) {
+    ncclNetProperties_t props;
+    NCCLCHECK(comm->ncclNet->getProperties(dev, &props));
+    if (props.railId == railId && (selectedDev == -1 || props.speed > selectedSpeed)) {
+      selectedDev = dev;
+      selectedSpeed = props.speed;
+    }
+  }
+
+  if (selectedDev == -1) {
+    WARN("No local NCCL plugin device advertises rail %d for peer node ID %d", railId, peerInfo->netNodeId);
+    return ncclInvalidUsage;
+  }
+
+  struct ncclTopoNode* selectedTopo = NULL;
+  for (int n = 0; n < comm->topo->nodes[NET].count; n++) {
+    struct ncclTopoNode* candidate = comm->topo->nodes[NET].nodes + n;
+    if (NCCL_TOPO_ID_SYSTEM_ID(candidate->id) != comm->topo->systemId || candidate->net.dev != selectedDev ||
+        candidate->net.railId != railId) {
+      continue;
+    }
+    if (selectedTopo != NULL) {
+      WARN("Multiple local topology devices match NCCL plugin device %d rail %d for peer node ID %d", selectedDev,
+           railId, peerInfo->netNodeId);
+      return ncclInvalidUsage;
+    }
+    selectedTopo = candidate;
+  }
+  if (selectedTopo == NULL) {
+    WARN("No local topology device matches NCCL plugin device %d rail %d for peer node ID %d", selectedDev,
+         railId, peerInfo->netNodeId);
+    return ncclInvalidUsage;
+  }
+
+  *netDev = selectedDev;
+  *netId = selectedTopo->id;
+  if (allowProxy) NCCLCHECK(ncclTopoGetIntermediateRank(comm->topo, myInfo->rank, *netId, proxyRank));
+  else *proxyRank = myInfo->rank;
+
+  INFO(NCCL_INIT | NCCL_NET,
+       "Peer rail override (topology-consistent) rank %d node %d -> rank %d node %d: rail %d via NET/%s/%d "
+       "topo_id=%lx proxy_rank=%d",
+       myInfo->rank, myInfo->netNodeId, peerInfo->rank, peerInfo->netNodeId, railId, comm->ncclNet->name, *netDev,
+       (unsigned long)*netId, *proxyRank);
+  return ncclSuccess;
+}
