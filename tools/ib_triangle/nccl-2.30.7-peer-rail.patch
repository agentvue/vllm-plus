+static ncclResult_t validatePeerRailConfig(struct ncclComm* comm) {
+  struct ncclPeerInfo* peers = comm->peerInfo;
+  bool enabled = peers[0].netPeerRailMapSet;
+
+  for (int i = 0; i < comm->nRanks; i++) {
+    if (peers[i].netPeerRailMapSet != enabled) {
+      WARN("NCCL_NET_PEER_RAIL_MAP must be set on every rank or on no ranks; rank %d configured=%d rank %d "
+           "configured=%d",
+           0, enabled, i, peers[i].netPeerRailMapSet);
+      return ncclInvalidUsage;
+    }
+    if (enabled != (peers[i].netNodeId >= 0)) {
+      WARN("NCCL_NET_NODE_ID and NCCL_NET_PEER_RAIL_MAP must be configured together on rank %d", i);
+      return ncclInvalidUsage;
+    }
+
+    for (int j = 0; j < i; j++) {
+      bool sameHost = peers[i].hostHash == peers[j].hostHash;
+      if (sameHost && peers[i].netNodeId != peers[j].netNodeId) {
+        WARN("Ranks %d and %d are on the same host but use different NCCL_NET_NODE_ID values %d and %d", j, i,
+             peers[j].netNodeId, peers[i].netNodeId);
+        return ncclInvalidUsage;
+      }
+      if (enabled && !sameHost && peers[i].netNodeId == peers[j].netNodeId) {
+        WARN("Ranks %d and %d are on different hosts but duplicate NCCL_NET_NODE_ID=%d", j, i,
+             peers[i].netNodeId);
+        return ncclInvalidUsage;
+      }
+    }
+  }
+
+  if (enabled && comm->rank == 0) {
+    char line[1024] = "";
+    for (int i = 0; i < comm->nRanks; i++) {
+      bool firstOnHost = true;
+      for (int j = 0; j < i; j++) {
+        if (peers[i].hostHash == peers[j].hostHash) {
+          firstOnHost = false;
+          break;
+        }
+      }
+      if (firstOnHost) {
+        snprintf(line + strlen(line), sizeof(line) - strlen(line), "%s%d", line[0] == '\0' ? "" : ",",
+                 peers[i].netNodeId);
+      }
+    }
+    INFO(NCCL_INIT | NCCL_NET, "Peer-aware rail selection enabled for node IDs [%s]", line);
+  }
+  return ncclSuccess;
+}
