@@ -16,6 +16,53 @@ import torch
 from vllm.triton_utils import tl, triton
 
 
+@triton.jit(do_not_specialize_on_alignment=["slots_ptr", "frames_ptr", "num_sampled_ptr"])
+def _consume_pp_frames_kernel(
+    slots_ptr,
+    frames_ptr,
+    num_sampled_ptr,
+    slot_frames_ptr,
+    history_ptr,
+    generated_ptr,
+    WIDTH: tl.constexpr,
+    MAX_FRAMES: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    slot = tl.load(slots_ptr + row).to(tl.int64)
+    valid = (slot >= 0) & (tl.load(num_sampled_ptr + row) > 0)
+    if valid:
+        count = tl.load(generated_ptr + slot).to(tl.int64)
+        index = tl.minimum(count, MAX_FRAMES - 1)
+        offsets = tl.arange(0, BLOCK)
+        values = tl.load(frames_ptr + row * WIDTH + offsets, offsets < WIDTH, other=0)
+        tl.store(slot_frames_ptr + slot * WIDTH + offsets, values, offsets < WIDTH)
+        tl.store(
+            history_ptr + (slot * MAX_FRAMES + index) * (WIDTH - 1) + offsets - 1,
+            values,
+            (offsets > 0) & (offsets < WIDTH),
+        )
+        tl.store(generated_ptr + slot, count + 1)
+
+
+def consume_pp_frames_(slots, frames, num_sampled, slot_frames, history, generated) -> None:
+    """Update unique live slots and their code history without dynamic indexing."""
+    if slots.numel() == 0:
+        return
+    _consume_pp_frames_kernel[(slots.numel(),)](
+        slots,
+        frames,
+        num_sampled,
+        slot_frames,
+        history,
+        generated,
+        WIDTH=frames.shape[1],
+        MAX_FRAMES=history.shape[1],
+        BLOCK=triton.next_power_of_2(frames.shape[1]),
+        num_warps=1,
+    )
+
+
 @triton.jit
 def _gemma_norm_row(x, w_ptr, offs, mask, n: tl.constexpr, eps):
     var = tl.sum(x * x, axis=0) / n
